[Desktop Entry]
Type=Application
Name=PdfCraft
GenericName=PDF Editor
Comment=Read, organize, combine, split and secure PDFs
Exec=pdfcraft %U
TryExec=pdfcraft
Icon=com.rehmanahmad.rehmanpdf
Terminal=false
StartupNotify=true
